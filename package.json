{
  "name": "secure-messenger-desktop",
  "productName": "secure-messenger-desktop",
  "version": "1.0.0",
  "description": "My Electron application description",
  "main": "dist/electron/main.js",
  "private": true,
  "scripts": {
    "start": "npm run build && electron-forge start",
    "build": "npm run typecheck && npm run build:main && npm run build:preload && npm run build:renderer && npm run copy:assets",
    "typecheck": "tsc --noEmit",
    "build:main": "esbuild electron/main.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/electron/main.js",
    "build:preload": "esbuild electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/electron/preload.js",
    "build:renderer": "esbuild src/index.tsx --bundle --platform=browser --format=iife --outfile=dist/src/renderer.js",
    "build:css": "node -e \"const fs = require('fs'); const path = require('path'); const src = fs.readFileSync('./src/index.css', 'utf8'); const preflight = fs.readFileSync('node_modules/tailwindcss/preflight.css', 'utf8'); const theme = fs.readFileSync('node_modules/tailwindcss/theme.css', 'utf8'); const utilities = fs.readFileSync('node_modules/tailwindcss/utilities.css', 'utf8'); const out = preflight + '\\n' + theme + '\\n' + utilities + '\\n' + src.replace(/@tailwind[^;]+;?/g, ''); fs.writeFileSync('./dist/src/index.css', out);\"",
    "copy:assets": "cpx src/index.html dist/src && npm run build:css",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make",
    "publish": "npm run build && electron-forge publish",
    "lint": "echo \"No linting configured\""
  },
  "keywords": [],
  "author": {
    "name": "Donnex Thyolera Kamsonga",
    "email": "67815785+dthyolerak@users.noreply.github.com"
  },
  "license": "MIT",
  "dependencies": {
    "@reduxjs/toolkit": "^2.2.3",
    "electron-squirrel-startup": "^1.0.1",
    "lucide-react": "^0.563.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^9.1.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "@types/node": "22.7.4",
    "@types/react": "^18.2.67",
    "@types/react-dom": "^18.2.21",
    "autoprefixer": "^10.4.23",
    "cpx": "^1.5.0",
    "electron": "40.0.0",
    "esbuild": "^0.20.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
